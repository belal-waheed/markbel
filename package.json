{
  "name": "markbel",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "wrangler dev worker/src/index.ts --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run",
    "preview": "vite preview",
    "worker:dev": "wrangler dev worker/src/index.ts",
    "worker:deploy": "npm run build && wrangler deploy",
    "d1:migrate:local": "wrangler d1 execute markbel-db --local --file=worker/schema.sql",
    "d1:migrate:remote": "wrangler d1 execute markbel-db --remote --file=worker/schema.sql",
    "pages:deploy": "wrangler pages deploy dist --project-name markbel",
    "cap:sync": "npx cap sync",
    "cap:build": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "clean:extension": "node -e \"['dist-extension', 'dist-extension-firefox'].forEach(d => fs.rmSync(d, { recursive: true, force: true }))\"",
    "build:extension": "vite build --config vite.config.extension.ts",
    "build:extension:firefox": "vite build --config vite.config.extension.ts --mode firefox",
    "extension:zip": "npm run build:extension && node scripts/zip-extension.cjs",
    "extension:zip:firefox": "npm run build:extension:firefox && node scripts/zip-extension-firefox.cjs",
    "build:extension:all": "npm run clean:extension && npm run extension:zip && npm run extension:zip:firefox",
    "sync:extension:unpacked": "node scripts/sync-extension-unpacked.cjs",
    "build:mcp": "npm --prefix packages/mcp run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@extractus/article-extractor": "^9.0.1",
    "@extractus/oembed-extractor": "^6.0.0",
    "@tanstack/react-virtual": "^3.14.26",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^16.5.0",
    "framer-motion": "^12.38.0",
    "hono": "^4.13.16",
    "lucide-react": "^0.577.0",
    "ofetch": "^1.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  }
}
