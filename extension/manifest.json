{
  "manifest_version": 3,
  "name": "Markbel — Quick Bookmarks",
  "short_name": "Markbel",
  "version": "1.0.0",
  "description": "Instant 1-click bookmarks, rich media metadata extraction, and smart grouping for Markbel.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Save to Markbel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "https://mark.obel.workers.dev/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "Open Markbel bookmark HUD"
    },
    "save-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Instantly save current tab to Markbel"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  }
}
