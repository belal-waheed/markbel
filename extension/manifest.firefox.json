{
  "manifest_version": 3,
  "name": "Markbel",
  "short_name": "Markbel",
  "version": "2.5.0",
  "description": "Instant 1-click bookmarks, rich media metadata extraction, and smart grouping for Markbel.",
  "browser_specific_settings": {
    "gecko": {
      "id": "markbel-extension@obel.dev",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Save to Markbel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "alarms",
    "notifications"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://mark.obel.workers.dev/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+B",
        "mac": "Command+B"
      },
      "description": "Open Markbel bookmark HUD"
    },
    "save-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Instantly save current tab to Markbel"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  }
}
