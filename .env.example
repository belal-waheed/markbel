# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MARKBEL ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# --- Authentication ---
JWT_SECRET=your-production-jwt-secret-here

# --- Upstash Redis (Metadata Scraper Cache) ---
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token-here

# --- Upstash QStash (15-Minute Reminder Cron & Webhooks) ---
QSTASH_TOKEN=your-qstash-token-here
QSTASH_CURRENT_SIGNING_KEY=sig_current_key_here
QSTASH_NEXT_SIGNING_KEY=sig_next_key_here

# --- Cron Trigger Secret ---
CRON_SECRET=your-cron-secret-here

# --- Web Push VAPID Notifications (Optional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@markbel.app

# --- Resend Email (Optional - For Password Reset) ---
RESEND_API_KEY=
